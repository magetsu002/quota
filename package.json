{
  "name": "quota-mcp-bridge",
  "version": "0.1.0",
  "description": "Self-hosted remote MCP bridge for ChatGPT, Claude, and any local stdio MCP server.",
  "type": "module",
  "license": "MIT",
  "author": "magetsu002",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "quota": "dist/cli.js",
    "quota-relay": "dist/relay/server.js",
    "quota-agent": "dist/agent/agent.js"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc",
    "test": "npm run build && node test/cli.test.js && node test/relay.test.js && node test/oauth.test.js",
    "start": "node dist/cli.js start",
    "relay": "node dist/cli.js relay",
    "agent": "node dist/cli.js agent",
    "status": "node dist/cli.js status",
    "token": "node dist/cli.js token",
    "dev:relay": "tsx src/relay/server.ts",
    "dev:agent": "tsx src/agent/agent.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chatgpt",
    "claude",
    "relay",
    "self-hosted",
    "remote-mcp"
  ]
}
