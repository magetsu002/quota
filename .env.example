# Relay
QUOTA_RELAY_HOST=127.0.0.1
QUOTA_RELAY_PORT=8787
QUOTA_DEVICE_TOKEN=replace-with-a-random-secret
QUOTA_MCP_TOKEN=replace-with-a-different-random-secret

# Agent
QUOTA_RELAY_URL=http://127.0.0.1:8787

# Optional: choose a specific agent when multiple are connected
# QUOTA_TARGET_DEVICE_ID=

# Optional direct-HTTPS OAuth mode
# QUOTA_PUBLIC_URL=https://mcp.example.com
# QUOTA_OAUTH_OWNER_SECRET=replace-with-a-random-owner-secret
# QUOTA_OAUTH_STATE_PATH=/home/you/.local/state/quota/oauth.json

# Optional agent provider config instead of CLI "-- command args..."
# QUOTA_MCP_COMMAND=node
# QUOTA_MCP_ARGS_JSON=["/path/to/server.js"]
# QUOTA_MCP_ENV_JSON={"EXAMPLE":"value"}
